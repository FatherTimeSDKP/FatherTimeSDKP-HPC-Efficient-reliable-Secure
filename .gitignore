# ==========================================
# Gypsi Consulting / FatherTimeSDKP .gitignore
# ==========================================

# Secrets & Environment Configurations
.env
*.env
.env.*

# Subscriber Database & SQLite Storage (DO NOT COMMIT)
*.db
fts_subscribers.db

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Operating System Files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# Virtual Environments
.venv/
venv/
ENV/
env/

# Build & Package Artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# Logs
*.log
pip-log.txt

# GitHub Pages / Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
/vendor
Gemfile.lock

# Client Simulation Outputs & Provenance JSON Exports
*.csv
*sealed.json
